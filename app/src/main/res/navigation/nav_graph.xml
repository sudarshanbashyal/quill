<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="mse.quill.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/noteEditorFragment"
        android:name="mse.quill.ui.notes.NoteEditorFragment"
        android:label="Note">
        <argument
            android:name="note_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="collection_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/collectionDetailFragment"
        android:name="mse.quill.ui.collections.CollectionDetailFragment"
        android:label="Collection">
        <argument
            android:name="collection_id"
            app:argType="string" />
        <argument
            android:name="collection_name"
            app:argType="string" />
    </fragment>

    <!-- Top-level destination, reachable from the bottom bar (see menu_bottom_nav.xml, whose item
         ids are these destination ids). -->
    <fragment
        android:id="@+id/flashcardDecksFragment"
        android:name="mse.quill.ui.flashcards.FlashcardDecksFragment"
        android:label="Flashcards" />

    <fragment
        android:id="@+id/flashcardsFragment"
        android:name="mse.quill.ui.flashcards.FlashcardsFragment"
        android:label="Flashcards">
        <argument android:name="note_id" app:argType="string" />
    </fragment>

    <!-- Top-level destination, reachable from the bottom bar. Its two children take a quiz id and
         nothing else: the questions are regenerated from the note each time, so there is no session
         state worth passing between screens. -->
    <fragment
        android:id="@+id/quizzesFragment"
        android:name="mse.quill.ui.quiz.QuizzesFragment"
        android:label="Quizzes" />

    <fragment
        android:id="@+id/quizDetailFragment"
        android:name="mse.quill.ui.quiz.QuizDetailFragment"
        android:label="Quiz">
        <argument android:name="quiz_id" app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/quizSessionFragment"
        android:name="mse.quill.ui.quiz.QuizSessionFragment"
        android:label="Quiz">
        <argument android:name="quiz_id" app:argType="string" />
    </fragment>

    <!-- add other fragments here -->
    <fragment
        android:id="@+id/whiteboardFragment"
        android:name="mse.quill.ui.whiteboard.WhiteboardFragment"
        android:label="Whiteboard">
        <!-- Both nullable: a board opened from Home has no parent note, and a brand new board has
             no id yet (the fragment mints one). -->
        <argument
            android:name="note_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="whiteboard_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <!-- A top-level destination (see menu_bottom_nav), so it takes no arguments and has no
         actions into it — the bar is the only way in. -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="mse.quill.ui.profile.ProfileFragment"
        android:label="Profile" />
</navigation>