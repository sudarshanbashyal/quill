<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="mse.quill.ui.home.HomeFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/noteEditorFragment"
        android:name="mse.quill.ui.notes.NoteEditorFragment"
        android:label="Note">
        <argument
            android:name="note_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="collection_id"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/collectionDetailFragment"
        android:name="mse.quill.ui.collections.CollectionDetailFragment"
        android:label="Collection">
        <argument
            android:name="collection_id"
            app:argType="string" />
        <argument
            android:name="collection_name"
            app:argType="string" />
    </fragment>

    <!-- Top-level destination, reachable from the bottom bar (see menu_bottom_nav.xml, whose item
         ids are these destination ids). -->
    <fragment
        android:id="@+id/flashcardDecksFragment"
        android:name="mse.quill.ui.flashcards.FlashcardDecksFragment"
        android:label="Flashcards" />

    <fragment
        android:id="@+id/flashcardsFragment"
        android:name="mse.quill.ui.flashcards.FlashcardsFragment"
        android:label="Flashcards">
        <argument android:name="note_id" app:argType="string" />
    </fragment>

    <!-- add other fragments here -->
    <fragment
        android:id="@+id/whiteboardFragment"
        android:name="mse.quill.ui.whiteboard.WhiteboardFragment"
        android:label="Whiteboard">
        <argument android:name="note_id" app:argType="string" />
        <argument android:name="whiteboard_id" app:argType="string" app:nullable="true" />
    </fragment>
</navigation>