<?xml version="1.0" encoding="utf-8"?>
<!-- Midday — the strongest colour of the three, and the only one that is warm all the way through.

     Same shape as bg_home_header, which this replaces at runtime — see TimeOfDay. angle=90 means
     startColor is the BOTTOM stop and endColor the TOP one, and there are deliberately no
     <corners>: the rounded edge belongs to bg_content_sheet, which curves over this. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/header_day_bottom"
        android:endColor="@color/header_day_top" />
</shape>
