<?xml version="1.0" encoding="utf-8"?>
<!-- The icon set is raster, and a menu item asks the drawable how big it is and believes the
     answer — which blows the popup out to the width of the icon. Everywhere else these are drawn
     into an ImageView with a fixed size, so nothing else has to care. This wrapper is the answer to
     that question.

     Since 2026-08-26 the PNGs live in drawable-xxxhdpi/ rather than a density-less drawable/, so
     the answer they'd give unwrapped is 64dp rather than 256dp. Better, still not 22dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_flashcard"
        android:width="@dimen/menu_icon_size"
        android:height="@dimen/menu_icon_size"
        android:gravity="center" />
</layer-list>
