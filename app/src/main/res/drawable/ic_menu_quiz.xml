<?xml version="1.0" encoding="utf-8"?>
<!-- The stopwatch at menu-item size. Same wrapper trick as ic_menu_flashcard.xml — a menu item
     asks the drawable how big it is and believes the answer, and a raster icon's answer is its
     own resolution, not the 22dp the popup wants. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_stopwatch"
        android:width="@dimen/menu_icon_size"
        android:height="@dimen/menu_icon_size"
        android:gravity="center" />
</layer-list>
