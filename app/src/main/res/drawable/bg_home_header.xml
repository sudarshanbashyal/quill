<?xml version="1.0" encoding="utf-8"?>
<!-- NOTE: the namespace must be .../apk/res/android. This file previously declared
     .../res/android (no "apk/"), which silently put every android: attribute into an
     unrecognized namespace — aapt reports no error, the shape then inflates with no shape
     type, no colour and no gradient, and the header drew nothing at all. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- angle=90 means startColor is the BOTTOM stop and endColor the TOP one. -->
    <gradient
        android:angle="90"
        android:startColor="@color/header_gradient_start"
        android:endColor="@color/header_gradient_end" />
    <!-- Deliberately no <corners>: this is a plain full-bleed rectangle that runs behind the
         content sheet. The rounded edge belongs to bg_content_sheet, which curves over this. -->
</shape>
