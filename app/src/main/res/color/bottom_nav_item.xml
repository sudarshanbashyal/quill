<?xml version="1.0" encoding="utf-8"?>
<!-- Selected tab in the brand purple, the other in the app's secondary text grey — the same pair
     the formatting toolbar uses for active/inactive, so "this one is current" reads the same way
     everywhere. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/brand_purple" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
