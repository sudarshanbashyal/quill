    <string name="collection_lock_title_format">Lock \"%s\"?</string>
    <!-- Says what it does and what it costs, in that order. The flashcard sentence is here because
         losing a review schedule is the one consequence a user would not otherwise predict. -->
    <string name="collection_lock_message">Notes in this collection will be encrypted with a key held by this device and unlocked with your fingerprint or screen lock.\n\nThey\'ll stop appearing on Home, in search, and in flashcards and quizzes until you unlock the collection.\n\nFlashcards made from these notes are removed — they store the question and answer in plain text. Re-open a note after unlocking to build its deck again.</string>
    <string name="collection_lock_confirm">Lock</string>
    <string name="collection_locking">Encrypting…</string>
    <string name="collection_locked">Collection locked</string>
    <string name="collection_lock_failed">Couldn\'t lock the collection. Nothing was changed.</string>
    <string name="collection_lock_unavailable">Set a screen lock or fingerprint in system settings first.</string>

    <string name="collection_unlock_title_format">Remove the lock on \"%s\"?</string>
    <string name="collection_unlock_message">The notes will be decrypted and stored in plain text again, and will reappear on Home, in search and in flashcards.</string>
    <string name="collection_unlock_confirm">Remove lock</string>
    <string name="collection_unlocked">Lock removed</string>
    <string name="collection_unlock_failed">Couldn\'t verify it\'s you. The collection stays locked.</string>
    <string name="collection_unlock_key_gone">This collection\'s key is gone, so its notes can\'t be decrypted.</string>

    <!-- Shown when the Keystore key has been destroyed — almost always because the device's screen
