<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared spacing -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <!-- Cards -->
    <dimen name="card_corner_radius">18dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <!-- Note rows are a shorter, tighter card than collection/pinned cards, so they get their own
         (smaller) radius rather than reusing card_corner_radius. -->
    <dimen name="note_row_corner_radius">12dp</dimen>

    <!-- Home header -->
    <dimen name="header_corner_radius">28dp</dimen>
    <!-- Header gradient block. In the Figma it is 177dp tall but the content sheet starts at
         120dp and covers the rest, so the visible band is 120dp — hence the height here and the
         (negative) overlap below, which pulls the sheet up over the gradient's bottom edge. -->
    <dimen name="header_min_height">176dp</dimen>
    <dimen name="content_sheet_overlap">-56dp</dimen>

    <!-- Search field (fragment_home / fragment_collection_detail) -->
    <dimen name="search_corner_radius">12dp</dimen>

    <!-- Color swatch picker (TagPickerDialog) -->
    <dimen name="swatch_size">36dp</dimen>
    <dimen name="swatch_margin">8dp</dimen>
    <dimen name="swatch_border_width">3dp</dimen>

    <!-- Tag chips (TagChipView) -->
    <dimen name="chip_padding_horizontal">10dp</dimen>
    <dimen name="chip_spacing">6dp</dimen>
    <dimen name="chip_max_width">120dp</dimen>
    <!-- Target overall pill height; replaces the old chip_padding_vertical now that Chip
         controls vertical sizing via min-height rather than View padding. -->
    <dimen name="chip_min_height">24dp</dimen>

    <!-- Tag picker dialog (TagPickerDialog) -->
    <dimen name="tag_dot_size">14dp</dimen>

    <!-- Pinned note cards (PinnedNoteCardView) -->
    <dimen name="pinned_card_width">150dp</dimen>

    <!-- Home FAB expanding menu -->
    <dimen name="fab_option_radius">24dp</dimen>
    <dimen name="fab_option_sweep_distance">40dp</dimen>

    <!-- Add-existing-notes dialog (AddExistingNotesDialog) -->
    <dimen name="note_picker_max_height">300dp</dimen>

    <!-- Inline images in the note body. Capped so a tall photo doesn't push the rest of the
         note off screen; tapping opens it full-size. -->
    <dimen name="note_image_max_height">280dp</dimen>

    <!-- Formatting toolbar (FormattingToolbarController). Items carry no fixed width — they are
         added with equal weights so the eight of them divide the full bar width evenly. The glyph
         is small but the whole weighted slot is the touch target, so it stays comfortably past
         the 48dp guidance. -->
    <dimen name="formatting_toolbar_height">48dp</dimen>
    <dimen name="formatting_icon_size">20dp</dimen>
    <dimen name="formatting_dot_size">5dp</dimen>
    <dimen name="formatting_dot_margin_top">3dp</dimen>
</resources>
