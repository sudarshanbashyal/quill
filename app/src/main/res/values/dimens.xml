<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shared spacing -->
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">16dp</dimen>
    <dimen name="spacing_lg">24dp</dimen>

    <!-- Back arrow. One size for every screen's header (see Widget.Quill.Button.Back): the chevron
         is the same gesture wherever it appears, so it should be the same object. -->
    <dimen name="back_icon_size">20dp</dimen>

    <!-- Cards -->
    <dimen name="card_corner_radius">18dp</dimen>
    <dimen name="card_elevation">0dp</dimen>
    <!-- Note rows are a shorter, tighter card than collection/pinned cards, so they get their own
         (smaller) radius rather than reusing card_corner_radius. -->
    <dimen name="note_row_corner_radius">12dp</dimen>

    <!-- Home header -->
    <dimen name="header_corner_radius">28dp</dimen>
    <!-- Header gradient block. In the Figma it is 177dp tall but the content sheet starts at
         120dp and covers the rest, so the visible band is 120dp — hence the height here and the
         (negative) overlap below, which pulls the sheet up over the gradient's bottom edge. -->
    <dimen name="header_min_height">176dp</dimen>
    <dimen name="content_sheet_overlap">-56dp</dimen>
    <!-- Matches the overlap above: the sheet has to be at least this tall for its rounded top to
         cover the gradient's bottom edge even when nothing is pinned. -->
    <!-- Exactly the corner radius, and for that reason: this height exists only so the sheet's
         rounded top is still drawn for someone who has pinned nothing. At 56dp it was twice what
         the curve needed, which read as an empty band above the search bar rather than as an
         edge. Kept in step with header_corner_radius by hand — a dimen cannot reference another. -->
    <dimen name="content_sheet_min_height">28dp</dimen>

    <!-- Search field (fragment_home / fragment_collection_detail) -->
    <dimen name="search_corner_radius">12dp</dimen>
    <!-- The filter button beside the search box, and the chips under it. -->
    <dimen name="search_filter_button_size">44dp</dimen>
    <dimen name="search_filter_icon_size">22dp</dimen>
    <dimen name="filter_chip_close_size">14dp</dimen>
    <!-- Ring around a selected tag in the filter sheet. -->
    <dimen name="filter_chip_selected_stroke">2dp</dimen>
    <!-- Ceiling for the filter sheet's scrolling body; it is shorter when there are few tags. -->
    <dimen name="filter_sheet_max_height">380dp</dimen>

    <!-- Splash logo. This is the "Q" glyph's text size; QuillLogoView derives the dots' size and
         spacing from the glyph's measured bounds, so this one value scales the whole mark. -->
    <dimen name="splash_logo_size">96dp</dimen>

    <!-- Color swatch picker (TagPickerDialog) -->
    <dimen name="swatch_size">36dp</dimen>
    <dimen name="swatch_margin">8dp</dimen>
    <dimen name="swatch_border_width">3dp</dimen>

    <!-- Tag chips (TagChipView) -->
    <dimen name="chip_padding_horizontal">10dp</dimen>
    <dimen name="chip_spacing">6dp</dimen>
    <dimen name="chip_max_width">120dp</dimen>
    <!-- Target overall pill height; replaces the old chip_padding_vertical now that Chip
         controls vertical sizing via min-height rather than View padding. -->
    <dimen name="chip_min_height">24dp</dimen>

    <!-- Tag picker dialog (TagPickerDialog) -->
    <dimen name="tag_dot_size">14dp</dimen>

    <!-- Bottom navigation, excluding the gesture-bar inset the bar adds to itself (MainActivity
         adds the two together). M3's own floor is 80dp, which was more than the three items need
         and came out of the list above. -->
    <dimen name="bottom_nav_height">56dp</dimen>
    <dimen name="bottom_nav_item_padding_top">2dp</dimen>
    <dimen name="bottom_nav_item_padding_bottom">2dp</dimen>

    <!-- Scroll slack under the last list item so it can clear the FAB (56dp + its 24dp margin). -->
    <dimen name="list_fab_clearance">88dp</dimen>

    <!-- Home list rhythm. Item views carry list_item_gutter as their own margin and the
         RecyclerView adds the same again as padding, so every item sits 16dp from the screen edge
         while two collection cards in a row are 16dp apart — one value, no per-column margins. -->
    <dimen name="list_item_gutter">8dp</dimen>
    <dimen name="section_header_margin_top">28dp</dimen>
    <dimen name="section_header_margin_bottom">12dp</dimen>
    <dimen name="section_header_icon">18dp</dimen>
    <!-- Doubles into the gap between two note rows. -->
    <dimen name="note_row_margin_vertical">6dp</dimen>

    <!-- Pinned note cards (PinnedNoteCardView). The height is fixed rather than wrapped: a card's
         title runs to one or two lines and its tag row may be absent entirely, and letting that
         drive the height left the row of cards visibly ragged. -->
    <dimen name="pinned_card_width">140dp</dimen>
    <!-- Preview strip on a Home whiteboard card. Roughly the 159x97 proportion the Figma
         HomePage_whiteboard frame uses, against this grid's narrower card. -->
    <dimen name="whiteboard_thumbnail_height">96dp</dimen>
    <!-- An attached board inside a note: tall enough to recognise the drawing, short enough that
         it doesn't push the writing off the screen. -->
    <dimen name="note_whiteboard_preview_height">160dp</dimen>
    <!-- Row thumbnail in the whiteboard picker: enough to recognise a diagram at a glance. -->
    <dimen name="whiteboard_picker_preview_size">56dp</dimen>
    <dimen name="pinned_card_height">108dp</dimen>
    <dimen name="pinned_card_gap">12dp</dimen>

    <!-- Home FAB expanding menu -->
    <dimen name="fab_option_radius">24dp</dimen>
    <dimen name="fab_option_sweep_distance">40dp</dimen>

    <!-- Add-existing-notes dialog (AddExistingNotesDialog) -->
    <dimen name="note_picker_max_height">300dp</dimen>

    <!-- Inline images in the note body. Capped so a tall photo doesn't push the rest of the
         note off screen; tapping opens it full-size. -->
    <dimen name="note_image_max_height">280dp</dimen>

    <!-- Q&A segment (QASegmentView). Proportions follow the MSE Figma's QA frame, scaled to the
         app's 16sp body type: a tonal rounded block, the question above, the answer indented
         behind a vertical rule. -->
    <!-- Recording blocks in a note. Sized to match a Q&A block's card so the two read as siblings;
         the waveform is given real height because it's the part carrying the information. -->
    <dimen name="audio_block_padding">12dp</dimen>
    <dimen name="audio_block_spacing">8dp</dimen>
    <dimen name="audio_block_gap">12dp</dimen>
    <dimen name="audio_waveform_height">36dp</dimen>
    <dimen name="audio_play_button_size">40dp</dimen>
    <dimen name="audio_time_text_size">12sp</dimen>

    <!-- Play/pause glyph (Widget.Quill.Button.Play). Bigger than a bordered icon would be: with no
         disc behind it, the glyph is the whole control. -->
    <dimen name="play_icon_size">26dp</dimen>

    <!-- The now-playing bar (MiniPlayerView), across the top of every screen. -->
    <dimen name="mini_player_padding_horizontal">8dp</dimen>
    <dimen name="mini_player_padding_vertical">6dp</dimen>
    <dimen name="mini_player_button_size">44dp</dimen>
    <dimen name="mini_player_icon_size">16dp</dimen>
    <dimen name="mini_player_waveform_height">20dp</dimen>
    <dimen name="mini_player_title_text_size">13sp</dimen>

    <dimen name="qa_block_padding">12dp</dimen>
    <dimen name="qa_block_spacing">8dp</dimen>
    <dimen name="qa_corner_radius">12dp</dimen>
    <dimen name="qa_rule_width">3dp</dimen>
    <dimen name="qa_rule_gap">12dp</dimen>
    <dimen name="qa_question_text_size">14sp</dimen>

    <!-- Popup menu items (see ic_menu_flashcard.xml). -->
    <dimen name="menu_icon_size">22dp</dimen>

    <!-- Export-complete dialog. -->
    <dimen name="export_dialog_padding">24dp</dimen>
    <dimen name="export_dialog_padding_bottom">8dp</dimen>
    <dimen name="export_dialog_gap">16dp</dimen>
    <dimen name="export_dialog_gap_small">6dp</dimen>
    <dimen name="export_badge_size">72dp</dimen>
    <dimen name="export_badge_icon_size">36dp</dimen>
    <dimen name="export_title_text_size">20sp</dimen>
    <dimen name="export_filename_text_size">13sp</dimen>

    <!-- Note editor toolbar. The options button's icon is three dots, so it wants to be smaller
         than a normal 24dp glyph or it reads as a heavy blob. -->
    <dimen name="note_options_icon_size">18dp</dimen>

    <!-- Flashcard review (FlashcardsFragment). The card is deliberately tall — it fills whatever
         the header and grading row leave — with the min-height only mattering on short screens. -->
    <dimen name="flashcard_min_height">240dp</dimen>
    <dimen name="flashcard_corner_radius">20dp</dimen>
    <dimen name="flashcard_grade_button_size">64dp</dimen>
    <!-- Half the button size — a square with a half-size corner radius is a circle, and stating it
         beats relying on whatever the tonal icon-button style's default shape happens to be. -->
    <dimen name="flashcard_grade_button_radius">32dp</dimen>
    <dimen name="flashcard_grade_icon_size">26dp</dimen>
    <dimen name="flashcard_message_icon_size">48dp</dimen>

    <!-- Flashcard deck rows (FlashcardDeckRowView). The badge is a pill rather than a circle so a
         two-digit due count doesn't get clipped. -->
    <dimen name="deck_badge_min_width">40dp</dimen>
    <dimen name="deck_badge_radius">14dp</dimen>
    <dimen name="deck_delete_size">36dp</dimen>
    <dimen name="deck_delete_icon_size">18dp</dimen>

    <!-- Quizzes. Options are cards rather than radio rows: an answer can be a sentence long, and a
         list-item-with-a-dot puts a 20dp target on something the whole width of the screen is
         offering. The stroke is what carries selection, so it needs to be visible at a glance. -->
    <dimen name="quiz_option_corner_radius">12dp</dimen>
    <dimen name="quiz_option_min_height">56dp</dimen>
    <dimen name="quiz_option_stroke_width">2dp</dimen>
    <dimen name="quiz_timer_size">22sp</dimen>
    <!-- Question indicators. Small, because there is one per question and a long quiz still has to
         fit a scannable row; the whole pip is the touch target, and the row scrolls when it can't
         fit rather than shrinking the pips below readable. -->
    <dimen name="quiz_indicator_size">28dp</dimen>
    <dimen name="quiz_indicator_spacing">6dp</dimen>
    <dimen name="quiz_indicator_stroke">2dp</dimen>
    <!-- Result rows reuse the Q&A block's vertical rule to mark right/wrong, so they share its
         width — one visual idiom for "this text belongs to that one". -->
    <dimen name="quiz_result_rule_width">3dp</dimen>
    <dimen name="quiz_badge_min_width">52dp</dimen>

    <!-- Profile / settings. Rows are a fixed minimum rather than wrapped: a two-line row and a
         one-line row next to each other looked ragged, and 56dp keeps the whole row past the 48dp
         touch guidance even where only the switch is interactive. -->
    <dimen name="profile_avatar_size">72dp</dimen>
    <dimen name="profile_avatar_text_size">28sp</dimen>
    <dimen name="settings_row_min_height">56dp</dimen>
    <dimen name="settings_icon_size">20dp</dimen>
    <dimen name="settings_section_spacing">20dp</dimen>
    <dimen name="settings_card_padding">4dp</dimen>
    <!-- The Danger Zone card is outlined rather than filled — a red block that size would shout
         from the moment the screen opens, which is not where the emphasis belongs. -->
    <dimen name="danger_card_stroke">1dp</dimen>

    <!-- App lock gate (the overlay over MainActivity while locked). -->
    <dimen name="app_lock_icon_size">48dp</dimen>

    <!-- Formatting toolbar (FormattingToolbarController). Items carry no fixed width — they are
         added with equal weights so the eight of them divide the full bar width evenly. The glyph
         is small but the whole weighted slot is the touch target, so it stays comfortably past
         the 48dp guidance. -->
    <dimen name="formatting_toolbar_height">48dp</dimen>
    <dimen name="formatting_icon_size">20dp</dimen>
    <dimen name="formatting_dot_size">5dp</dimen>
    <dimen name="formatting_dot_margin_top">3dp</dimen>
</resources>
