<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="brand_purple">#7C6FEA</color>
    <color name="brand_purple_dark">#5C4DD6</color>
    <color name="brand_purple_light">#EFECFE</color>
    <!-- The logo mark's own two colours, sampled from res/drawable/logo.png. They back the
         launcher icon and the splash, which is why they are a pair of their own rather than
         brand_purple_light/text_primary — the tile is cooler and the ink is more neutral than
         either, and the launcher icon has to keep matching the splash it hands off to. -->
    <color name="brand_lavender">#DFE7FB</color>
    <color name="brand_ink">#2D2E37</color>

    <!-- Surfaces / backgrounds. The MSE Figma uses a white page throughout, with the tonal
         surface_container below doing the work of separating rows/cards from it — so
         app_background is white rather than the old off-white #F8F7FC, which sat too close to
         surface_container for the cards to read. -->
    <color name="app_background">#FFFFFFFF</color>
    <color name="surface">#FFFFFFFF</color>
    <!-- Tonal surface behind filled cards (note rows, collection cards) — sampled from the MSE
         Figma file's home/collection screens, which draw those as flat grey fills, not shadows. -->
    <color name="surface_container">#F5F6FA</color>

    <!-- Text -->
    <color name="text_primary">#1E1B2E</color>
    <color name="text_secondary">#8B879C</color>
    <color name="text_on_brand">#FFFFFFFF</color>

    <!-- Home header gradient. bg_home_header draws at angle=90, i.e. _start is the BOTTOM stop
         and _end the TOP one. Both sampled down the left edge of the MSE Figma home frame, which
         fades a saturated lavender at the top out to near-background by the time the content
         starts. -->
    <color name="header_gradient_start">#EFECFD</color>
    <color name="header_gradient_end">#CAC3FA</color>

    <!-- Q&A blocks. The rule beside an answer is sampled from the MSE Figma's QA frame; the
         question colour is that frame's 59%-black, deliberately not text_secondary (which is a
         purple-grey tuned for note metadata, and reads as a different kind of text here). -->
    <color name="qa_answer_rule">#30B488</color>
    <color name="qa_question_text">#96000000</color>

    <!-- Flashcard grading. Green/red are doing semantic work here (right vs. wrong), not brand
         work, so they're their own pair rather than a tint of brand_purple; the container tones are
         what the buttons are actually filled with, keeping the pair quiet until it's looked at. -->
    <color name="answer_correct">#1E8E5A</color>
    <color name="answer_correct_container">#E1F3EA</color>
    <color name="answer_incorrect">#C0392F</color>
    <color name="answer_incorrect_container">#FBE7E5</color>

    <!-- Misc -->
    <color name="uncategorized_gray">#9E9E9E</color>
    <color name="divider">#EBE9F2</color>

    <!-- Launcher icon / splash -->
    <color name="ic_launcher_background">@color/brand_lavender</color>
    <color name="splash_background">@color/brand_lavender</color>
</resources>
