<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="white">#FFFFFFFF</color>

    <!-- Brand -->
    <color name="brand_purple">#7C6FEA</color>
    <color name="brand_purple_dark">#5C4DD6</color>
    <color name="brand_purple_light">#EFECFE</color>

    <!-- Study calendar (StudyCalendarView). Four steps of the brand purple against the card's own
         fill, so a busy week reads as the app's colour rather than as a second palette. The empty
         cell is deliberately visible — a grid that showed only the days you studied would be a
         scatter of dots with nothing to measure them against. -->
    <color name="study_cell_empty">#E8E7EF</color>
    <color name="study_cell_light">#CFC9F7</color>
    <color name="study_cell_medium">#A79BF1</color>
    <color name="study_cell_strong">#7C6FEA</color>
    <!-- The logo mark's own two colours, sampled from res/drawable/logo.png. They back the
         launcher icon and the splash, which is why they are a pair of their own rather than
         brand_purple_light/text_primary — the tile is cooler and the ink is more neutral than
         either, and the launcher icon has to keep matching the splash it hands off to. -->
    <color name="brand_lavender">#DFE7FB</color>
    <color name="brand_ink">#2D2E37</color>

    <!-- Surfaces / backgrounds. The MSE Figma uses a white page throughout, with the tonal
         surface_container below doing the work of separating rows/cards from it — so
         app_background is white rather than the old off-white #F8F7FC, which sat too close to
         surface_container for the cards to read. -->
    <color name="app_background">#FFFFFFFF</color>
    <color name="surface">#FFFFFFFF</color>
    <!-- Tonal surface behind filled cards (note rows, collection cards) — sampled from the MSE
         Figma file's home/collection screens, which draw those as flat grey fills, not shadows. -->
    <color name="surface_container">#F5F6FA</color>

    <!-- Text -->
    <color name="text_primary">#1E1B2E</color>
    <color name="text_secondary">#8B879C</color>
    <color name="text_on_brand">#FFFFFFFF</color>

    <!-- Home header gradient. bg_home_header draws at angle=90, i.e. _start is the BOTTOM stop
         and _end the TOP one. Both sampled down the left edge of the MSE Figma home frame, which
         fades a saturated lavender at the top out to near-background by the time the content
         starts. -->
    <color name="header_gradient_start">#EFECFD</color>
    <color name="header_gradient_end">#CAC3FA</color>

    <!-- Home's headers, one per part of the day (see home_morning / home_day / home_night in the
         MSE Figma file; evening has no frame and was drawn to sit between day and night). Named
         _top and _bottom by where the colour actually appears, not by the gradient's start/end:
         bg_home_header draws at angle=90, which puts startColor at the BOTTOM, and two of these
         palettes are dark at the top — mixing the two namings up would invert the sky.

         Read down the list they are one day: dawn breaking over a warm horizon, open blue at noon,
         a sunset, then navy. -->
    <color name="header_morning_top">#76A2BD</color>
    <color name="header_morning_bottom">#FFA880</color>
    <color name="header_day_top">#538DCD</color>
    <color name="header_day_bottom">#BDCFE6</color>
    <!-- The only warm sky of the four, which is the point: five to nine is the one stretch the
         blue palettes cannot cover without lying about the hour. Kept light enough at the top for
         header_ink_dark — it sits about where header_morning_top does against that ink. -->
    <color name="header_evening_top">#E4796B</color>
    <color name="header_evening_bottom">#F7C77E</color>
    <color name="header_night_top">#0B5786</color>
    <color name="header_night_bottom">#001D2C</color>

    <!-- Ink for the headers above. Morning and day are light enough for the app's near-black;
         night is not, so it takes the design's pale mint instead of white — white on that navy is
         harsher than the rest of Quill's type ever is. -->
    <color name="header_ink_dark">#2D2E37</color>
    <color name="header_ink_light">#B9E8E7</color>

    <!-- Q&A blocks. The rule beside an answer is sampled from the MSE Figma's QA frame; the
         question colour is that frame's 59%-black, deliberately not text_secondary (which is a
         purple-grey tuned for note metadata, and reads as a different kind of text here). -->
    <!-- The not-yet-played part of a waveform. Light enough to read as the track behind the
         playhead rather than as a second colour competing with the brand purple. -->
    <color name="waveform_unplayed">#D5D2E4</color>

    <color name="qa_answer_rule">#30B488</color>
    <color name="qa_question_text">#96000000</color>

    <!-- Flashcard grading. Green/red are doing semantic work here (right vs. wrong), not brand
         work, so they're their own pair rather than a tint of brand_purple; the container tones are
         what the buttons are actually filled with, keeping the pair quiet until it's looked at. -->
    <color name="answer_correct">#1E8E5A</color>
    <color name="answer_correct_container">#E1F3EA</color>
    <color name="answer_incorrect">#C0392F</color>
    <color name="answer_incorrect_container">#FBE7E5</color>

    <!-- Destructive actions (Profile's Danger Zone). Aliases rather than a second red: Quill has
         one, and a delete-everything button that didn't match the app's own "wrong" colour would
         be reading as a different kind of warning than it is. -->
    <color name="danger">@color/answer_incorrect</color>

    <color name="divider">#EBE9F2</color>
    <!-- Search box outline: the Figma's rgba(37,38,42,0.17) flattened onto white, so the box reads
         as an outlined field without Material's heavier default stroke. -->
    <color name="search_stroke">#D7D6D9</color>

    <!-- Launcher icon / splash -->
    <color name="ic_launcher_background">@color/brand_lavender</color>
    <color name="splash_background">@color/brand_lavender</color>
</resources>
