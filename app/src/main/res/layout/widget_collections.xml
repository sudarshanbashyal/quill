<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_root_background"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_pinned_notes_header"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Fixed rather than weighted: pinned notes are capped at MAX_PINNED_NOTES (3), so there's
         a real ceiling on how much room this section ever needs, unlike collections below (which
         scrolls). A weight here claimed a share of the widget proportional to its size, not its
         content, and kept looking oversized regardless of how that share was split. Sized for
         roughly two compact rows before it scrolls the rest. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/widget_pinned_notes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_pinned_notes_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_pinned_notes_empty"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </FrameLayout>

    <!-- A plain View isn't in RemoteViews' inflatable-class allowlist (unlike TextView, which
         is) — using one here throws at inflation time and the whole widget falls back to
         Android's "Problem loading widget" placeholder instead of rendering. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_collections_header"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/widget_collections_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_collections_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_collections_empty"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </FrameLayout>

</LinearLayout>
