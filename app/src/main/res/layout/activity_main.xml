<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:name="androidx.navigation.fragment.NavHostFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    >

    <!-- Whatever Quill is playing — a recording from a note, or a note being read aloud — above
         every screen and gone when there is nothing. A row of its own rather than something
         floating over the content: hovering covered the controls of whatever was underneath.
         Collapsed to nothing when hidden, so the nav host starts at the top as it always did. -->
    <mse.quill.ui.audio.MiniPlayerView
        android:id="@+id/mini_player"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:navGraph="@navigation/nav_graph"
        app:defaultNavHost="true"
        app:layout_constraintTop_toBottomOf="@id/mini_player"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Only shown on the two top-level destinations (see MainActivity). Everything else — the
         editor, a review session — is somewhere you came *from* one of them, and a bar offering to
         jump away mid-note is noise. When it's gone the nav host's bottom constraint collapses to
         the parent, so those screens get the full height. -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:itemIconTint="@color/bottom_nav_item"
        app:itemPaddingBottom="@dimen/bottom_nav_item_padding_bottom"
        app:itemPaddingTop="@dimen/bottom_nav_item_padding_top"
        app:itemTextColor="@color/bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- The app lock's gate. Last child on purpose: a ConstraintLayout draws its children in order,
         so being declared after the nav host, the bottom bar and the now-playing bar is what puts
         it over all three — a gate that left the tabs tappable underneath would be scenery.

         An overlay in this window rather than an Activity of its own, because a separate Activity
         would have to be launched before the content it hides was ever composed, and the moment it
         got that wrong the notes would flash up behind it. Here there is nothing to race: the view
         is either visible or it isn't, and MainActivity sets that before the frame is drawn.

         clickable/focusable are what stop touches and TalkBack reaching what's behind. -->
    <LinearLayout
        android:id="@+id/app_lock_gate"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/app_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <ImageView
            android:layout_width="@dimen/app_lock_icon_size"
            android:layout_height="@dimen/app_lock_icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_private"
            app:tint="@color/brand_purple" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="@string/app_lock_gate_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Empty until something goes wrong, and gone rather than blank so the button doesn't
             shift down a line the first time a lockout is reported. -->
        <TextView
            android:id="@+id/app_lock_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Too many attempts. Try again in a moment."
            tools:visibility="visible" />

        <!-- The system dialog opens by itself when the gate appears; this is for after it has been
             dismissed, which otherwise leaves a locked screen with no way forward. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/app_lock_unlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/app_lock_gate_action" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>