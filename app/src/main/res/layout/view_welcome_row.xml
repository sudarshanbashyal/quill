<?xml version="1.0" encoding="utf-8"?>
<!-- One line of either list on the welcome screen: what Quill does before the choice, and what was
     created after it. The same row for both on purpose — the second list reads as the answer to the
     first, which it is. Inflated by WelcomeActivity rather than written out four times here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/welcome_row_icon"
        android:layout_width="@dimen/welcome_row_icon"
        android:layout_height="@dimen/welcome_row_icon"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        app:tint="@color/brand_purple" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/welcome_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/welcome_row_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
