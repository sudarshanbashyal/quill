<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_whiteboard.xml  (SINGLE-DEVICE VERSION)

    Layout structure:
    ┌────────────────────────────────────────────┐
    │  Top bar: status | undo | clear | export    │
    ├──────────────┬─────────────────────────────┤
    │  Left        │                             │
    │  tool        │    WhiteboardView           │
    │  sidebar     │    (drawing canvas)         │
    │              │                             │
    └──────────────┴─────────────────────────────┘

    No bottom bar in this version — that's added back later
    when Wi-Fi Direct collaboration is introduced.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- ── Top toolbar ───────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Whiteboard"
            android:textSize="14sp"
            android:textColor="#444444"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:id="@+id/colorIndicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/circle_indicator"
            android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_undo"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Undo last stroke"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_clear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear whiteboard"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btnExport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_export"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Export as image" />

    </LinearLayout>

    <!-- ── Left tool sidebar ──────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/leftSidebar"
        android:layout_width="52dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Drawing tools -->
        <ImageButton
            android:id="@+id/btnPen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_pen"
            android:background="@drawable/tool_selector_bg"
            android:contentDescription="Pen tool"
            android:layout_marginBottom="4dp" />

        <ImageButton
            android:id="@+id/btnEraser"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_eraser"
            android:background="@drawable/tool_selector_bg"
            android:contentDescription="Eraser tool"
            android:layout_marginBottom="4dp" />

        <ImageButton
            android:id="@+id/btnHighlighter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_highlighter"
            android:background="@drawable/tool_selector_bg"
            android:contentDescription="Highlighter tool"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Colors -->
        <ImageButton
            android:id="@+id/btnColorBlack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_black"
            android:contentDescription="Black"
            android:layout_marginBottom="6dp" />

        <ImageButton
            android:id="@+id/btnColorRed"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_red"
            android:contentDescription="Red"
            android:layout_marginBottom="6dp" />

        <ImageButton
            android:id="@+id/btnColorBlue"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_blue"
            android:contentDescription="Blue"
            android:layout_marginBottom="6dp" />

        <ImageButton
            android:id="@+id/btnColorGreen"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_green"
            android:contentDescription="Green"
            android:layout_marginBottom="6dp" />

        <ImageButton
            android:id="@+id/btnColorYellow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_yellow"
            android:contentDescription="Yellow"
            android:layout_marginBottom="12dp" />

        <View
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="12dp" />

        <!-- Stroke widths -->
        <ImageButton
            android:id="@+id/btnWidthThin"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_width_thin"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thin stroke"
            android:layout_marginBottom="4dp" />

        <ImageButton
            android:id="@+id/btnWidthMedium"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_width_medium"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Medium stroke"
            android:layout_marginBottom="4dp" />

        <ImageButton
            android:id="@+id/btnWidthThick"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_width_thick"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thick stroke" />

    </LinearLayout>

    <!-- ── Whiteboard drawing canvas ─────────────────────────────────────── -->
    <mse.quill.ui.whiteboard.WhiteboardView
        android:id="@+id/whiteboardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftSidebar"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>