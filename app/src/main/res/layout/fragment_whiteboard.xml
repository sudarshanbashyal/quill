<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_whiteboard.xml  (SINGLE-DEVICE VERSION)

    Layout structure:
    ┌────────────────────────────────────────────┐
    │  Heading (editable)                    👁   │
    ├──────────────┬─────────────────────────────┤
    │              │                             │
    │  Tools,      │    WhiteboardView           │
    │  colours,    │    (drawing canvas)         │
    │  widths,     │                             │
    │  actions     │                             │
    │  (centred)   │                             │
    └──────────────┴─────────────────────────────┘

    Everything but the heading lives in the left rail, so the canvas keeps one clean edge and
    the tools sit under the thumb rather than at the far top of a tall screen. The eye toggle
    stays in the top bar because a control cannot be the thing it hides.

    No bottom bar in this version — that's added back later
    when Wi-Fi Direct collaboration is introduced.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8">

    <!-- ── Top bar: the board's name, and nothing else to compete with it ──── -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Same back control as the note editor and every other detail screen. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/Widget.Quill.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Named here rather than in a dialog before the board opens, the way a note is named in
             its editor: you rarely know what a board is called until you have drawn on it. The
             hint carries the same "Untitled Whiteboard - <date>" fallback every list resolves. -->
        <EditText
            android:id="@+id/titleInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/note_title_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnToggleTools"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:src="@drawable/ic_invisible"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_hide_tools" />

    </LinearLayout>

    <!-- ── Whiteboard drawing canvas ─────────────────────────────────────────
         Full width, with the rail floating over it: anything less leaves a grey gutter down the
         side, and hiding the rail would resize the canvas and shift the drawing under your hand. -->
    <mse.quill.ui.whiteboard.WhiteboardView
        android:id="@+id/whiteboardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFF"
        android:scrollbars="horizontal|vertical"
        android:scrollbarStyle="insideOverlay"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Where typed text is entered, positioned at the tap and hidden the rest of the time. It
         lives over the canvas rather than in it, so the canvas keeps knowing nothing about views.
         Panning is suspended while it is open, which is why it can be placed once and left.
         Single-line on purpose: with textMultiLine the IME replaces its Done key with a newline,
         and there is then no gesture that says "this label is finished". -->
    <EditText
        android:id="@+id/textEditor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="120dp"
        android:background="@drawable/bg_text_editor"
        android:hint="@string/hint_whiteboard_text"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:padding="6dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Left rail: every tool and action, centred against the canvas ─────
         Sized to its buttons, not to the screen — constrained top and bottom with
         layout_constrainedHeight so it centres while it fits and shrinks (scrolling inside)
         only on a screen too short to hold it, rather than being cut off. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/leftSidebar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="@dimen/card_corner_radius"
        app:cardElevation="0dp"
        app:strokeColor="#E0E0E0"
        app:strokeWidth="1dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="8dp">

            <!-- Drawing tools -->
            <ImageButton
                android:id="@+id/btnPen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_pen"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Pen tool"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnEraser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_eraser"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Eraser tool"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnHighlighter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_highlighter"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Highlighter tool"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnText"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_text"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="@string/action_text_tool"
                android:layout_marginBottom="4dp" />

            <!-- Move: a finger pans instead of drawing. Two-finger pan works whatever tool is
                 selected, so this is for one-handed use rather than a way to reach the canvas. -->
            <ImageButton
                android:id="@+id/btnMove"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_move"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="@string/action_move_tool"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <!-- Colors -->
            <ImageButton
                android:id="@+id/btnColorBlack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/circle_black"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Black"
                android:layout_marginBottom="2dp" />

            <ImageButton
                android:id="@+id/btnColorRed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/circle_red"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Red"
                android:layout_marginBottom="2dp" />

            <ImageButton
                android:id="@+id/btnColorBlue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/circle_blue"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Blue"
                android:layout_marginBottom="2dp" />

            <ImageButton
                android:id="@+id/btnColorGreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/circle_green"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Green"
                android:layout_marginBottom="2dp" />

            <ImageButton
                android:id="@+id/btnColorYellow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/circle_yellow"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Yellow"
                android:layout_marginBottom="2dp" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <!-- Stroke widths -->
            <ImageButton
                android:id="@+id/btnWidthThin"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_width_thin"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Thin stroke"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnWidthMedium"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_width_medium"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Medium stroke"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnWidthThick"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_width_thick"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="Thick stroke"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnWidthExtraThick"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_width_extra_thick"
                android:background="@drawable/tool_selector_bg"
                android:contentDescription="@string/action_width_extra_thick" />

            <View
                android:layout_width="32dp"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="12dp" />

            <!-- Board actions. Centre first: on a canvas this size it is the one you reach for
                 when you have panned somewhere and lost the drawing. -->
            <ImageButton
                android:id="@+id/btnBackground"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_paper"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_background"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnCollab"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_collab"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_collaborate"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnCentre"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_centre"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_centre_canvas"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_undo"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo last stroke"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear whiteboard"
                android:layout_marginBottom="4dp" />

            <ImageButton
                android:id="@+id/btnExport"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:src="@drawable/ic_export"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Export as image" />

        </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
