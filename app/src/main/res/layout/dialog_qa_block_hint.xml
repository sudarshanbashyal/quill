<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the Q&A hint dialog. The strip in the middle is left empty here and filled by
     QaBlockHintDialog with real FormattingButtonViews, so the picture is built from the same
     item list as the toolbar it is a picture of. The card around it clips the strip, which is
     what lets the strip be scaled up past its own bounds to zoom in on one item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/qa_hint_dialog_padding"
    android:paddingEnd="@dimen/qa_hint_dialog_padding"
    android:paddingTop="@dimen/qa_hint_gap_small"
    android:paddingBottom="@dimen/qa_hint_dialog_padding_bottom">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/qa_hint_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2sp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/qa_hint_text_size" />

    <!-- Quiz only: the shortfall as a number, because "not enough" and "you have three of five"
         are different amounts of help when the user is deciding whether to bother. -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/qa_hint_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qa_hint_gap_small"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/qa_hint_text_size"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/qa_hint_strip_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qa_hint_gap"
        app:cardBackgroundColor="@color/surface_container"
        app:cardCornerRadius="@dimen/qa_hint_strip_corner"
        app:cardElevation="0dp"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp">

        <!-- Clips the zoom. The strip is scaled about the Q&A item's centre, so at full zoom the
             items either side of it run off the edges of this frame — which is the whole effect. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/formatting_toolbar_height"
            android:clipChildren="true">

            <LinearLayout
                android:id="@+id/qa_hint_strip"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/qa_hint_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/qa_hint_gap_small"
        android:gravity="center_horizontal"
        android:text="@string/qa_hint_caption"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/qa_hint_caption_text_size" />

</LinearLayout>
