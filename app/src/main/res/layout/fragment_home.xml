<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- The greeting and the pinned band scroll away; the search bar does not. That split is what
         AppBarLayout is for: a child with app:layout_scrollFlags="scroll" leaves with the content,
         a child with no flags stays pinned at the top. Doing it with a plain LinearLayout would
         mean either everything is fixed (the old layout) or everything scrolls. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/home_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_header"
        android:fitsSystemWindows="true"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">

            <!-- The sheet's overlap is a negative *bottom* margin here rather than a negative top
                 margin on the sheet itself. LinearLayout.measureVertical accumulates with
                 totalLength = max(totalLength, totalLength + childHeight + margins), and that max
                 swallows a negative margin on the following child. -->
            <!-- gravity="top", not centre: the minimum height here is the whole 176dp gradient,
                 but the content sheet is pulled up over its bottom 56dp, so centring the text in
                 the header sinks it towards an edge that isn't there and leaves the subtitle
                 pressed against the sheet. -->
            <LinearLayout
                android:id="@+id/home_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/content_sheet_overlap"
                android:orientation="horizontal"
                android:gravity="top"
                android:minHeight="@dimen/header_min_height"
                android:paddingHorizontal="@dimen/spacing_lg"
                android:paddingTop="@dimen/home_header_text_top"
                android:paddingBottom="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Playfair Display, the display serif from the MSE Figma file. Its
                         font-family ships real italic and bold cuts (see
                         font/playfair_display.xml), so the textStyle below selects them rather
                         than synthesising a slant. -->
                    <!-- Both lines, and both their colours, are set in code: which greeting
                         appears depends on the hour and on whether Profile has a display name.
                         See HomeFragment.renderHeader. The text here is the fallback the layout
                         preview shows. -->
                    <TextView
                        android:id="@+id/home_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_greeting"
                        android:fontFamily="@font/playfair_display"
                        android:textSize="24sp"
                        android:textStyle="italic|bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/home_greeting_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/home_header_line_gap"
                        android:text="@string/home_greeting_subtitle"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <!-- Night only. Decoration, so it is hidden from accessibility rather than
                     described to someone who cannot see the sky it is sitting in anyway — the
                     greeting beside it already says what time of day it is. -->
                <ImageView
                    android:id="@+id/home_header_stars"
                    android:layout_width="@dimen/home_header_stars_size"
                    android:layout_height="@dimen/home_header_stars_size"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_stars"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Carries the sheet's rounded top over the header gradient. Always present, with a
                 minimum height, so the rounding survives a user who has pinned nothing. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_content_sheet"
                android:minHeight="@dimen/content_sheet_min_height"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/pinned_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_md"
                        android:layout_marginTop="@dimen/section_header_margin_top"
                        android:layout_marginBottom="@dimen/section_header_margin_bottom"
                        android:drawableStart="@drawable/ic_section_pin"
                        android:drawablePadding="@dimen/spacing_sm"
                        android:drawableTint="@color/text_primary"
                        android:gravity="center_vertical"
                        android:text="@string/section_pinned_notes"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:id="@+id/pinned_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/pinned_cards_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                    </HorizontalScrollView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- No scroll flags: this is the one thing that stays. Opaque, because the list scrolls
             underneath it rather than stopping at it. -->
        <mse.quill.ui.search.SearchFilterBar
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_sm" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- paddingHorizontal pairs with the matching margin every item view sets on itself; see
         list_item_gutter. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/list_item_gutter"
        android:paddingBottom="@dimen/list_fab_clearance"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <LinearLayout
        android:id="@+id/fab_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/fab_option_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_section_note"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@color/text_on_brand"
            android:gravity="center_vertical"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_note"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fab_option_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_section_collection"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@color/text_on_brand"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_collection"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fab_option_whiteboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_section_whiteboard"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@color/text_on_brand"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_whiteboard"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Joining someone else's whiteboard used to live inside a whiteboard: you opened one of
             your own boards to get at the button that joined a different one. It belongs here, with
             the other ways a thing arrives on Home — a session is not something you do *to* a
             board, it is a way of getting one. -->
        <TextView
            android:id="@+id/fab_option_join"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_option_join"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@color/text_on_brand"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_join_session"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Last, and the only option here that doesn't bring something into being — a note
             someone else wrote arrives through the same control that makes new ones, because to
             the user both end in "a note on Home that wasn't there before". It sits at the bottom
             of the list, nearest the FAB: the three "make one" options are what the button is for,
             and this is the exception you reach past them for. -->
        <TextView
            android:id="@+id/fab_option_import"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_option_import"
            android:drawablePadding="@dimen/spacing_sm"
            android:drawableTint="@color/text_on_brand"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_import_note"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="New note"
        app:srcCompat="@drawable/ic_add"
        app:backgroundTint="@color/text_primary"
        app:tint="@color/text_on_brand" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Masks the strip behind the status bar, and sits outside the CoordinatorLayout on purpose:
         inside it, fitsSystemWindows offsets the scrim below the very strip it needs to cover.
         An AppBarLayout deliberately lets its scrolling child pass *behind* the status bar — the
         parallax behaviour a CollapsingToolbar relies on — so without this the pinned cards slide
         up over the clock. Coloured to the gradient's top stop, so it is invisible while the
         header shows and reads as a tinted status bar once it has gone. -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/header_gradient_end" />

</FrameLayout>
