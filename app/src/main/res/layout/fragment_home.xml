<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The sheet's overlap is a negative *bottom* margin here rather than a negative top
             margin on the sheet itself. LinearLayout.measureVertical accumulates with
             totalLength = max(totalLength, totalLength + childHeight + margins), and that max
             swallows a negative margin on the weighted child: the sheet was pulled up 56dp but
             measured 56dp short with it, leaving a dead band of exactly that height between the
             end of the list and the bottom bar. Charged to this view instead, it shortens
             totalLength for real and the sheet reaches the bottom. -->
        <LinearLayout
            android:id="@+id/home_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/content_sheet_overlap"
            android:orientation="vertical"
            android:background="@drawable/bg_home_header"
            android:minHeight="@dimen/header_min_height"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- Playfair Display, the display serif from the MSE Figma file. Its font-family ships
                 real italic and bold cuts (see font/playfair_display.xml), so the textStyle below
                 selects them rather than making Android synthesise a slant. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_greeting"
                android:fontFamily="@font/playfair_display"
                android:textSize="24sp"
                android:textStyle="italic|bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/home_greeting_subtitle"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <!-- Everything below the greeting rides on a sheet whose rounded top corners overlap
             the header gradient — see bg_content_sheet. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_content_sheet"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/pinned_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_md"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:layout_marginBottom="@dimen/section_header_margin_bottom"
                android:drawableStart="@drawable/ic_section_pin"
                android:drawablePadding="@dimen/spacing_sm"
                android:drawableTint="@color/text_primary"
                android:gravity="center_vertical"
                android:text="@string/section_pinned_notes"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/pinned_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_md"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pinned_cards_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

        </LinearLayout>

        <mse.quill.ui.search.SearchFilterBar
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg" />

        <!-- paddingHorizontal pairs with the matching margin every item view sets on itself; see
             list_item_gutter. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/list_item_gutter"
            android:paddingBottom="@dimen/list_fab_clearance" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/fab_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="96dp"
        android:orientation="vertical"
        android:gravity="end"
        android:visibility="gone">

        <TextView
            android:id="@+id/fab_option_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_note"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fab_option_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_collection"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fab_option_whiteboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:background="@drawable/bg_fab_option"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_sm"
            android:text="@string/action_create_whiteboard"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="New note"
        app:srcCompat="@drawable/ic_add"
        app:backgroundTint="@color/text_primary"
        app:tint="@color/text_on_brand" />

</FrameLayout>
