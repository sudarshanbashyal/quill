<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top toolbar — no title text (the note's own title field below serves that purpose), so
         kept compact rather than a full-height empty app bar. -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Everything the whole note can have done to it — read aloud, turned into flashcards —
             lives behind this one control, in the toolbar rather than beside the title so it stays
             put as the note scrolls. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_options_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/action_note_options"
            app:icon="@drawable/ic_option"
            app:iconSize="@dimen/note_options_icon_size"
            app:iconTint="@color/text_primary" />

    </androidx.appcompat.widget.Toolbar>

    <!-- Scrollable note content -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/formatting_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/note_editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/note_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@null"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionNext"
                android:maxLines="2" />

            <HorizontalScrollView
                android:id="@+id/tag_row_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tag_row_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <mse.quill.ui.notes.editor.NoteEditorView
                android:id="@+id/note_editor_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Formatting toolbar — pinned to bottom, sits flush against the keyboard. The items are
         added with equal weights so they spread across the full width and line up with the
         keyboard's own columns; that also means the row can never overflow, so no scroll
         container is needed around it. -->
    <LinearLayout
        android:id="@+id/formatting_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/formatting_toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/bg_formatting_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>