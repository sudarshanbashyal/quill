<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Header: back, title, options — one row, the way every other screen's header reads. The
         title used to be the first thing inside the ScrollView, which left the bar above it
         holding nothing but two buttons and put the note's name on a line of its own. It's the
         subject of this screen, so it belongs beside the controls that act on it; keeping it out
         of the scrolling content also means it stays legible while you write further down. -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_sm"
        android:paddingVertical="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/Widget.Quill.Button.Back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Single line, unlike the two it used to get: a title that grows to a second line while
             being typed would shove the whole note down a row mid-keystroke. Long titles scroll
             within the field instead. -->
        <EditText
            android:id="@+id/note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/note_title_hint"
            android:imeOptions="actionNext"
            android:inputType="textNoSuggestions"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Everything the whole note can have done to it — read aloud, turned into flashcards —
             lives behind this one control. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/note_options_button"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_note_options"
            app:icon="@drawable/ic_option"
            app:iconSize="@dimen/note_options_icon_size"
            app:iconTint="@color/text_primary" />

    </LinearLayout>

    <!-- Scrollable note content -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/formatting_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/note_editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <HorizontalScrollView
                android:id="@+id/tag_row_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/tag_row_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <mse.quill.ui.notes.editor.NoteEditorView
                android:id="@+id/note_editor_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Formatting toolbar — pinned to bottom, sits flush against the keyboard. The items are
         added with equal weights so they spread across the full width and line up with the
         keyboard's own columns; that also means the row can never overflow, so no scroll
         container is needed around it. -->
    <LinearLayout
        android:id="@+id/formatting_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/formatting_toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:background="@drawable/bg_formatting_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>