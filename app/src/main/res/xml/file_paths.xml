<?xml version="1.0" encoding="utf-8"?>
<!-- Backs the FileProvider declared in AndroidManifest. The single entry has to cover
     getFilesDir()/images, which is where ImageEmbedder.createPrivateImageFile() writes the
     capture target it hands to the camera app. -->
<paths>
    <files-path
        name="images"
        path="images/" />
    <!-- Exported notes, so the "Open" button on the export dialog has a shareable uri to hand to
         a viewer. Only reachable below API 29 — from there up the export is a MediaStore entry and
         its own uri is already shareable. -->
    <external-path
        name="exports"
        path="Download/Quill/" />
</paths>
