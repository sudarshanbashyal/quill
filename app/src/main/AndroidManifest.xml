<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Playing a recording outlives the screen it started on: the foreground service is what keeps
         the process alive once Quill isn't visible (a locked phone, another app), and the
         notification it must show is also the lock-screen control. POST_NOTIFICATIONS is asked for
         at the moment the first clip is played — denying it costs the controls, not the audio. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only for saving an image out to the gallery below API 29. From 29 on, scoped storage
         lets an app add its own entries to MediaStore without asking. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Nearby Connections, for the live whiteboard session. Nothing here reaches the internet:
         Nearby picks among BLE, Bluetooth, Wi-Fi Direct and a local hotspot, which is why the list
         spans all of them, and why it is this long.

         The API-level split is Android's, not ours. Up to 30 the Bluetooth permissions are
         unversioned and *location* is what gates BLE scanning; 31 renamed them into the
         BLUETOOTH_SCAN/ADVERTISE/CONNECT trio; 33 added NEARBY_WIFI_DEVICES so Wi-Fi peer
         discovery no longer has to borrow location either. Each is capped to the range where it
         is still the right one, or the newer devices ask for permissions they don't use.

         usesPermissionFlags="neverForLocation" on the two scanning permissions is the honest
         declaration and worth making: Quill uses these to find one phone across a table, never to
         work out where the user is. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="28" />
    <!-- Still required up to 31: below 31 it gates BLE scanning outright, and on 31/32 Nearby's
         Wi-Fi discovery has no NEARBY_WIFI_DEVICES to use instead. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- The join QR is scanned by Play Services' own scanner UI, in its process, so Quill never
         holds CAMERA. Declared optional so a device without one still installs — it simply can't
         be the joiner. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quill">
        <!-- The launcher entry point is the splash, which finishes itself into MainActivity once
             its animation minimum and StartupTasks are both done. It carries its own theme so the
             window the system draws before the first frame is already the splash's lavender. -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Quill.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported so a file manager, mail client or Quick Share can hand a received .quill /
             .quillboard / .quillpack straight to Quill instead of leaving the user to run Home's
             manual Import option afterwards. A pathPattern can't be trusted here: a file arriving
             over Quick Share is a content:// Uri typed application/octet-stream with no usable
             path, so the mimeTypes below are the only thing worth matching on, and the real check
             is still BundleReader/WhiteboardBundleReader/CollectionBundleReader's, tried in
             sequence by HomeFragment.handleSharedFile after the file is actually opened — same
             posture as the FAB's own *&#47;* picker filter. application/octet-stream is
             deliberately broad for that reason: it's what most transports label an unrecognised
             attachment, and narrowing it would silently exclude the common case. -->
        <!-- singleTask: without it, tapping a second file while Quill is already open would launch
             a second MainActivity instance stacked on the first (the default "standard" launch
             mode's answer to any external VIEW intent) rather than reusing the running one and its
             single nav host — this app is one Activity by design (see note.md). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/zip" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/zip" />
                <data android:scheme="file" android:mimeType="application/json" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- Not exported: nothing outside the app has any business starting playback. Its actions
             arrive from its own notification's PendingIntents and from the media session. -->
        <service
            android:name=".audio.AudioPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Required by ImageEmbedder.openCamera(): it hands the camera app a content:// URI
             for a file in getFilesDir()/images. The authority must match what that code builds
             (getPackageName() + ".fileprovider"). Without this declaration
             FileProvider.getUriForFile throws IllegalArgumentException ("Couldn't find
             meta-data for provider with authority ...") — which is not an IOException, so
             openCamera()'s catch does not cover it and the app crashes outright. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>