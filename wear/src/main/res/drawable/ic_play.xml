<!-- Vector rather than the PNGs the phone module carries: these are drawn at three sizes on a
     watch (button, tile, complication) and tinted by the theme, and a bitmap can do neither. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M8,5v14l11,-7z" />
</vector>
